# EAS build archive exclusions (extends .gitignore intent).
# Keeps the upload small and secrets out of the build archive.
node_modules/
backend/
.expo/

# Never archive a stale native project: EAS must run `expo prebuild` from
# app.json so config plugins (expo-build-properties / usesCleartextTraffic)
# are applied to the generated manifest.
android/
ios/
.verify-dist/

# Explicitly include assets/ (icon/splash required by prebuild)
!assets/
dist/
dist-verify/
web-build/
*.log
.DS_Store
.env
# Artboard / deck files are not part of the app bundle
Safe Pakistan.html
PitchDeck.html
SystemDesign.html
