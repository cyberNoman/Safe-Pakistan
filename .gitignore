node_modules/
.expo/
.qoder/
dist/
dist-verify/
.verify-dist/
web-build/

# Native folders are generated, not tracked: EAS builds run `expo prebuild`
# on the server (CNG). A stray local `android/` must never be committed — it
# pins native code that the managed workflow is meant to regenerate.
android/
ios/
*.log
.DS_Store
.env
backend/.env
*.apk

# Runtime family-push token store (device-scoped Expo tokens — never commit).
backend/family.json

# Fine-tuned model weights (~1GB) — exceeds GitHub's 100MB file limit and is
# not a secret but must never be in git. Distribute via Ollama/HF registry.
backend/hifazat-edge.gguf

# Dev diagnostic that prints the API-key prefix to console — never commit.
backend/test-key.js

# One-off test artifacts
test-result.json

# Scratch artifacts — root only (leading /) so assets/ screenshots stay tracked
/*.png
deck-*.png
run*.txt
