# Safe Pakistan backend environment template.
# Copy to backend/.env and fill in real values. NEVER commit backend/.env.
# The server loads backend/.env explicitly (cwd-independent, see index.js).

# Layer 2 — Alibaba Cloud Model Studio (OpenAI-compatible endpoint)
QWEN_BASE_URL=https://YOUR-WORKSPACE.maas.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=sk-YOUR-MODEL-STUDIO-KEY

# Layer 1 — local fine-tuned model served by Ollama
FT_MODEL=hifazat-edge
FT_BASE_URL=http://127.0.0.1:11434/v1

# Layer 2 model id
MAX_MODEL=qwen-max
